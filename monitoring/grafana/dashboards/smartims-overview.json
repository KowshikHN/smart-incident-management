{
  "uid": "smartims-overview",
  "title": "Smart IMS Overview",
  "tags": [
    "smart-ims",
    "spring-boot",
    "postgres"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
